---
// Pagefind search UI. The index + UI assets are emitted by the build pipeline
// into `/pagefind/`; this component lazily loads them on first paint.
import { searchModule } from "@/modules/search";

const { bundlePath, placeholder } = searchModule.defaults;
---

<div class="dropdown dropdown-end">
  <div tabindex="0" role="button" class="btn btn-ghost btn-circle" aria-label="搜索">
    <svg
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      class="size-5"
      aria-hidden="true"
    >
      <circle cx="11" cy="11" r="8"></circle>
      <path d="m21 21-4.3-4.3"></path>
    </svg>
  </div>
  <div
    tabindex="0"
    class="dropdown-content z-50 mt-3 w-[min(28rem,90vw)] rounded-box border border-base-300 bg-base-100 p-4 shadow-lg"
  >
    <div data-pagefind-ui data-bundle-path={bundlePath} data-placeholder={placeholder}></div>
  </div>
</div>

<script is:inline define:vars={{ bundlePath, placeholder }}>
  (() => {
    const root = document.querySelector("[data-pagefind-ui]");
    if (!root || root.dataset.ready === "true") {
      return;
    }

    const css = document.createElement("link");
    css.rel = "stylesheet";
    css.href = `${bundlePath}pagefind-ui.css`;
    document.head.appendChild(css);

    const script = document.createElement("script");
    script.src = `${bundlePath}pagefind-ui.js`;
    script.onload = () => {
      root.dataset.ready = "true";
      const PagefindUI = window.PagefindUI;
      if (typeof PagefindUI === "function") {
        new PagefindUI({ element: root, showSubResults: true, placeholder });
      }
    };
    document.head.appendChild(script);
  })();
</script>
