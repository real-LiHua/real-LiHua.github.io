---
// Optional explicit copy button. The `code-copy` client module also auto-injects
// a button into every highlighted `<pre>`; this component is for cases where a
// caller wants to place/annotate the control itself.
interface Props {
  target?: string;
  label?: string;
}

const { target = "pre", label = "复制代码" } = Astro.props as Props;
---

<button
  type="button"
  class="btn btn-xs btn-ghost"
  data-code-copy
  data-target={target}
  aria-label={label}
>
  {label}
</button>
