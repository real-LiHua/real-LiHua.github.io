---
// Post card — supports `grid` (default surface) and `list` (compact, side) layouts.
import type { PostCardProps } from "@/modules/types";
import { uiComponents } from "@/modules/ui-components";
import { formatDate } from "@/utils/date";
import Tag from "./Tag.astro";

const props = Astro.props as PostCardProps;
const entry = props.post;
const { title, description, tags, publishDate, image } = entry.data;
const href = uiComponents.postHref(entry.id);
const isList = props.variant === "list";
const revealIndex = props.variant === "grid" ? (props.revealIndex ?? 0) : 0;
---

<article
  class:list={[
    "card bg-base-100 shadow-sm transition-shadow hover:shadow-md",
    isList ? "card-side" : "h-full",
  ]}
  data-reveal
  data-reveal-index={String(revealIndex)}
  data-tilt={isList ? undefined : "true"}
>
  {
    image && (
      <figure class={isList ? "w-40 shrink-0" : ""}>
        <img src={image} alt={title} loading="lazy" class="h-full w-full object-cover" />
      </figure>
    )
  }
  <div class="card-body">
    <h2 class="card-title text-lg">
      <a href={href} class="link link-hover">{title}</a>
    </h2>
    {description && <p class="line-clamp-3 text-sm text-base-content/70">{description}</p>}
    <div class="mt-auto flex flex-wrap items-center gap-2 pt-2">
      <time class="text-xs text-base-content/60" datetime={publishDate?.toISOString()}>
        {formatDate(publishDate)}
      </time>
      {tags?.map((tag: string) => <Tag tag={tag} size="xs" />)}
    </div>
  </div>
</article>
