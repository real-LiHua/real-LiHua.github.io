---
// Tag chip linking to the tag archive.
import type { TagProps } from "@/modules/types";
import { uiComponents } from "@/modules/ui-components";

const { tag, href = uiComponents.tagHref(tag), size = "sm", variant = "soft" } =
  Astro.props as TagProps;

const styleClass = variant === "solid" ? "" : `badge-${variant}`;
---

<a class:list={["badge", `badge-${size}`, styleClass, "badge"]} href={href}>#{tag}</a>
