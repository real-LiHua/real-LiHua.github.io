---
// Drafts are only served in development; in production this route redirects home.
import BaseLayout from "@/layouts/BaseLayout.astro";
import PostCard from "@/components/common/PostCard.astro";
import { contentPipeline } from "@/modules/content-pipeline";

export const prerender = false;

if (!import.meta.env.DEV) {
  return Astro.redirect("/");
}

const drafts = await contentPipeline.getDraftPosts();
---

<BaseLayout title="草稿" description="草稿文章（仅开发环境可见）。">
  <div class="alert alert-warning mb-6">
    <span>这些是草稿（位于 <code>src/posts/drafts/</code>），不会出现在生产构建中。</span>
  </div>
  <h1 class="text-3xl font-bold">草稿</h1>

  <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
    {drafts.map((post, index) => <PostCard post={post} variant="grid" revealIndex={index} />)}
  </div>
</BaseLayout>
