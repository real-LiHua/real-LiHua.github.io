---
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout title="页面未找到" description="404 — 页面未找到。">
  <section class="grid min-h-[50vh] place-items-center text-center">
    <div>
      <p class="text-6xl font-bold text-primary">404</p>
      <h1 class="mt-4 text-2xl font-semibold">页面未找到</h1>
      <p class="mt-2 text-base-content/60">你访问的页面不存在或已被移动。</p>
      <a class="btn btn-primary mt-6" href="/">返回首页</a>
    </div>
  </section>
</BaseLayout>
