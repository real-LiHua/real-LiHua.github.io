---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PostCard from "@/components/common/PostCard.astro";
import { contentPipeline } from "@/modules/content-pipeline";

const posts = await contentPipeline.getPublishedPosts();
---

<BaseLayout title="文章" description="全部文章存档。" pagefind={true}>
  <header class="flex items-end justify-between">
    <h1 class="text-3xl font-bold">文章</h1>
    <p class="text-sm text-base-content/60">共 {posts.length} 篇</p>
  </header>

  {
    posts.length === 0 ? (
      <p class="mt-8 text-base-content/60">暂无文章。</p>
    ) : (
      <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {posts.map((post, index) => (
          <PostCard post={post} variant="grid" revealIndex={index} />
        ))}
      </div>
    )
  }
</BaseLayout>
