---
import type { CollectionEntry } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Tag from "@/components/common/Tag.astro";
import { contentPipeline } from "@/modules/content-pipeline";
import { telegramAuth } from "@/modules/telegram-auth";
import { formatDate } from "@/utils/date";

export async function getStaticPaths() {
  const posts = await contentPipeline.getAllPosts();
  const visible = import.meta.env.DEV
    ? posts
    : posts.filter((post) => !contentPipeline.isDraft(post));
  return visible.map((post) => ({ params: { id: post.id }, props: { post } }));
}

interface Props {
  post: CollectionEntry<"blog">;
}

const { post } = Astro.props as Props;
const { Content, headings, frontmatter } = await contentPipeline.renderPost(post.id);

const authConfig = frontmatter.telegramAuth;
const requiresAuth = telegramAuth.requiresAuth(authConfig);
const env = import.meta.env as Record<string, string | undefined>;
const botUsername = env.PUBLIC_TG_BOT_USERNAME ?? "your_bot";
---

<BaseLayout
  title={frontmatter.title}
  description={frontmatter.description ?? undefined}
  publishDate={frontmatter.publishDate}
  updatedDate={frontmatter.updatedDate}
  authors={frontmatter.authors}
  image={frontmatter.image}
  pagefind={!requiresAuth}
>
  <div class="grid gap-10 lg:grid-cols-[minmax(0,1fr)_16rem]">
    <article class="prose mx-auto w-full max-w-none" data-article>
      <header class="not-prose mb-8">
        <h1 class="text-3xl font-bold sm:text-4xl">{frontmatter.title}</h1>
        <div class="mt-3 flex flex-wrap items-center gap-3 text-sm text-base-content/60">
          <time datetime={frontmatter.publishDate?.toISOString()}>
            {formatDate(frontmatter.publishDate, "full")}
          </time>
          {frontmatter.tags?.map((tag: string) => <Tag tag={tag} />)}
        </div>
      </header>

      {
        requiresAuth ? (
          <div
            class="not-prose card items-center bg-base-200 p-8 text-center"
            data-telegram-auth
            data-post-id={post.id}
            data-group-name={authConfig?.groupName ?? "私密群组"}
            data-bot-username={botUsername}
          >
            <h2 class="text-xl font-semibold">此文章需要验证</h2>
            <p class="mt-2 text-sm text-base-content/60">
              {authConfig?.customMessage ?? "加入 Telegram 群组后即可阅读全文。"}
            </p>
          </div>
        ) : (
          <Content />
        )
      }
    </article>

    {
      headings.length > 0 && !requiresAuth && (
        <aside class="hidden lg:block">
          <div class="sticky top-24" data-toc>
            <h2 class="mb-2 text-sm font-semibold text-base-content/70">目录</h2>
            <div data-toc-container>
              <ul class="menu menu-sm w-full">
                {headings.map((heading) => (
                  <li style={`padding-inline-start:${heading.depth > 2 ? "1rem" : "0"}`}>
                    <a href={`#${heading.slug}`} data-toc-link={heading.slug}>
                      {heading.text}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </aside>
      )
    }
  </div>
</BaseLayout>
