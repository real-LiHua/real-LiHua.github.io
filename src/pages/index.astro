---
import SiteLayout from "../layouts/SiteLayout.astro";
import { getCollection } from "astro:content";
import { assertUniqueSeriesPositions } from "../lib/content-validation";

export const prerender = true;

const collectionPosts = await getCollection("posts");
assertUniqueSeriesPositions(collectionPosts);
const posts = collectionPosts.sort(
  (first, second) => second.data.publishedAt.valueOf() - first.data.publishedAt.valueOf(),
);
---

<SiteLayout title="首页">
  <section class="page-intro">
    <p class="eyebrow">阅读与记录</p>
    <h1>最近的文章</h1>
    <p>一处安静的长文阅读空间。</p>
  </section>
  <p class="preview-note">预览示例 · 以下内容仅用于界面预览</p>
  <ul class="post-list">
    {posts.map((post) => (
      <li>
        <article>
          <p class="post-meta">{post.data.publishedAt.toISOString().slice(0, 10)} · {post.data.readingTime}</p>
          <h2><a href={`/posts/${post.id}/`}>{post.data.title}</a></h2>
          <p>{post.data.description}</p>
        </article>
      </li>
    ))}
  </ul>
</SiteLayout>
