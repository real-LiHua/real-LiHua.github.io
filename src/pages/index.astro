---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PostCard from "@/components/common/PostCard.astro";
import { contentPipeline } from "@/modules/content-pipeline";

const posts = await contentPipeline.getPublishedPosts();
const recent = posts.slice(0, 6);
---

<BaseLayout
  title="LiHua.dev"
  description="个人博客：记录文章、笔记与技术实验。"
  pagefind={true}
>
  <section class="hero rounded-box bg-base-200 py-16">
    <div class="hero-content text-center">
      <div class="max-w-2xl">
        <h1 class="text-4xl font-bold tracking-tight sm:text-5xl">
          记录 <span class="text-primary">想法</span> 的地方
        </h1>
        <p class="py-6 text-base-content/70">
          文章、笔记与技术实验。用 Astro 构建，支持全文搜索、深浅色主题与 Telegram 认证阅读。
        </p>
        <div class="flex flex-wrap justify-center gap-3">
          <a class="btn btn-primary" href="/posts/">浏览文章</a>
          <a class="btn" href="/about/">关于本站</a>
        </div>
      </div>
    </div>
  </section>

  {
    recent.length > 0 && (
      <section class="mt-12">
        <div class="mb-6 flex items-end justify-between">
          <h2 class="text-2xl font-semibold">最新文章</h2>
          <a class="link link-hover text-sm" href="/posts/">
            查看全部 →
          </a>
        </div>
        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {recent.map((post, index) => (
            <PostCard post={post} variant="grid" revealIndex={index} />
          ))}
        </div>
      </section>
    )
  }
</BaseLayout>
