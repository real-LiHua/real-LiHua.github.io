---
// Base layout — the single HTML shell for every page.
// Owns SEO meta, structured data (JSON-LD), the CSP meta, the no-flash theme
// script, View Transitions and the one client entry script
// (docs/adr/0007-client-module-registry.md, docs/SEO.md,
// docs/SECURITY_WHITEPAPER.md §3.2).
import { ClientRouter } from "astro:transitions";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { themeSystem } from "@/modules/theme-system";
import type { BaseLayoutProps } from "@/modules/types";
import "@/styles/global.css";

const {
  title = "LiHua.dev",
  description = "个人博客：记录文章、笔记与技术实验。",
  pagefind = false,
  publishDate,
  updatedDate,
  authors,
  tags,
  image,
  canonical,
  noindex = false,
  jsonLd: extraJsonLd,
} = Astro.props as BaseLayoutProps;

const siteName = "LiHua.dev";
const fullTitle = title === siteName ? title : `${title} · ${siteName}`;
const base = Astro.site ?? Astro.url;
const canonicalURL = (canonical ? new URL(canonical, base) : new URL(Astro.url.pathname, base)).toString();
const rssURL = new URL("/rss.xml", base).toString();
const ogImage = new URL(image ?? "/og-default.png", base).toString();
const ogImageAlt = image ? fullTitle : `${siteName}：记录、文章与技术实验`;
const themeScript = themeSystem.inlineScript();
const isArticle = Boolean(publishDate);

// Baseline CSP (docs/SECURITY_WHITEPAPER.md §3.2). Two deliberate deviations
// from the whitepaper's sketch, both documented there:
//   - no CDN origin is whitelisted because the site loads no third-party
//     scripts (Pagefind assets are emitted same-origin under /pagefind/);
//   - `'unsafe-inline'` is required by the inline no-flash theme script, the
//     lazily injected Pagefind UI loader and Astro's ClientRouter.
// `'wasm-unsafe-eval'` is required by the Pagefind WASM index.
// `frame-ancestors` is omitted on purpose: meta-delivered CSP cannot enforce
// it — that header must be served by the host (see the whitepaper §3.3).
const csp = [
  "default-src 'self'",
  "script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval'",
  "style-src 'self' 'unsafe-inline'",
  "img-src 'self' data: https:",
  "font-src 'self' data:",
  "connect-src 'self'",
  "frame-src 'self'",
  "object-src 'none'",
  "base-uri 'self'",
  "form-action 'self'",
  "upgrade-insecure-requests",
].join("; ");

// Structured data (docs/SEO.md §6). WebSite for index-like pages, BlogPosting
// for articles. `<` is escaped so a title/description can never close the
// script element early.
const jsonLd = isArticle
  ? {
      "@context": "https://schema.org",
      "@type": "BlogPosting",
      headline: title,
      description,
      url: canonicalURL,
      mainEntityOfPage: canonicalURL,
      ...(ogImage ? { image: ogImage } : {}),
      ...(publishDate ? { datePublished: new Date(publishDate).toISOString() } : {}),
      ...(updatedDate ? { dateModified: new Date(updatedDate).toISOString() } : {}),
      ...(authors?.length ? { author: authors.map((name) => ({ "@type": "Person", name })) } : {}),
      ...(tags?.length ? { keywords: tags.join(", ") } : {}),
    }
  : {
      "@context": "https://schema.org",
      "@type": "WebSite",
      name: siteName,
      url: base.toString(),
      description,
    };
const additionalJsonLd: Record<string, unknown>[] = [];
if (extraJsonLd) {
  additionalJsonLd.push(...(Array.isArray(extraJsonLd) ? extraJsonLd : [extraJsonLd]));
}
const jsonLdScripts = [jsonLd, ...additionalJsonLd].map((schema) =>
  JSON.stringify(schema).replaceAll("<", String.raw`\u003c`),
);
---

<!doctype html>
<html lang="zh-CN" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta http-equiv="Content-Security-Policy" content={csp} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title={siteName} href={rssURL} />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {tags?.length && <meta name="keywords" content={tags.join(", ")} />}
    <link rel="canonical" href={canonicalURL} />

    <meta property="og:type" content={isArticle ? "article" : "website"} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={ogImageAlt} />
    {authors?.map((author) => <meta property="article:author" content={author} />)}
    {publishDate && <meta property="article:published_time" content={new Date(publishDate).toISOString()} />}
    {updatedDate && <meta property="article:modified_time" content={new Date(updatedDate).toISOString()} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    {jsonLdScripts.map((schema) => <script type="application/ld+json" set:html={schema} />)}

    {pagefind && <link rel="stylesheet" href="/pagefind/pagefind-ui.css" />}
    <script is:inline set:html={themeScript} />
    <ClientRouter />
  </head>
  <body class="flex min-h-dvh flex-col bg-base-100 text-base-content">
    <Header />
    <main class="mx-auto w-full max-w-6xl flex-1 px-4 py-8">
      <slot />
    </main>
    <Footer />
    <script>
      import "@/scripts/client-entry";
    </script>
  </body>
</html>
