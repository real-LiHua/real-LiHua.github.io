---
// Base layout — the single HTML shell for every page.
// Owns SEO meta, the no-flash theme script, View Transitions and the one client
// entry script (docs/adr/0007-client-module-registry.md).
import { ClientRouter } from "astro:transitions";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { themeSystem } from "@/modules/theme-system";
import type { BaseLayoutProps } from "@/modules/types";
import "@/styles/global.css";

const {
  title = "LiHua.dev",
  description = "个人博客：记录文章、笔记与技术实验。",
  pagefind = false,
  publishDate,
  updatedDate,
  authors,
  image,
  canonical,
} = Astro.props as BaseLayoutProps;

const siteName = "LiHua.dev";
const fullTitle = title === siteName ? title : `${title} · ${siteName}`;
const base = Astro.site ?? Astro.url;
const canonicalURL = canonical ? new URL(canonical, base) : new URL(Astro.url.pathname, base);
const ogImage = image ? new URL(image, base).toString() : undefined;
const themeScript = themeSystem.inlineScript();
---

<!doctype html>
<html lang="zh-CN" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <meta property="og:type" content="article" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    {authors?.map((author) => <meta property="article:author" content={author} />)}
    {publishDate && <meta property="article:published_time" content={new Date(publishDate).toISOString()} />}
    {updatedDate && <meta property="article:modified_time" content={new Date(updatedDate).toISOString()} />}
    <meta name="twitter:card" content={ogImage ? "summary_large_image" : "summary"} />

    {pagefind && <link rel="stylesheet" href="/pagefind/pagefind-ui.css" />}
    <script is:inline set:html={themeScript} />
    <ClientRouter />
  </head>
  <body class="flex min-h-dvh flex-col bg-base-100 text-base-content">
    <Header />
    <main class="mx-auto w-full max-w-6xl flex-1 px-4 py-8">
      <slot />
    </main>
    <Footer />
    <script>
      import "@/scripts/client-entry";
    </script>
  </body>
</html>
