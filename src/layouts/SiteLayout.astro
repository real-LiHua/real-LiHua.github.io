---
import "../styles/global.css";
import "virtual:blog-maple-font";
import SiteSearch from "../components/SiteSearch.astro";
import Icon from "../components/Icon.astro";

interface Props {
  title: string;
  description?: string;
}

const { title, description = "个人博客阅读预览。" } = Astro.props;
const {pathname} = Astro.url;
const isHome = pathname === "/";
const isPostsSection =
  pathname.startsWith("/posts") ||
  pathname.startsWith("/topics") ||
  pathname.startsWith("/series");
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="alternate" type="application/rss+xml" title="文章订阅" href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="ard" href="/.well-known/ard.json" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <meta name="color-scheme" content="light dark" />
    <script is:inline>
      // Telegram Mini App bootstrap. Runs before first paint and never waits
      // on the network: the launch parameters travel in the URL fragment, so
      // the forced client palette can be applied synchronously. In-app
      // navigations are full page loads that drop the fragment, so the
      // launch parameters are persisted to sessionStorage (per tab) and a
      // later page in the same session restores them from there. The SDK
      // (injected after window.load) only adds ready()/expand()/chrome sync.
      const TGLAUNCH_KEY = "tg-launch";
      const hashParams = new URLSearchParams(window.location.hash.replace(/^#/u, ""));
      let tgParams = hashParams;
      let inTelegram = tgParams.has("tgWebAppPlatform") || tgParams.has("tgWebAppData");

      if (inTelegram) {
        // First paint of a launch: remember the fragment for in-app navigations.
        try {
          const subset = new URLSearchParams();
          for (const [key, value] of hashParams) {
            if (key.startsWith("tgWebApp")) {
              subset.set(key, value);
            }
          }
          sessionStorage.setItem(TGLAUNCH_KEY, subset.toString());
        } catch {
          // Storage unavailable (e.g. private mode) — this page still works;
          // later navigations degrade to the regular browser palette.
        }
      } else {
        // Navigated within the Mini App: restore the persisted launch fragment.
        try {
          const stored = sessionStorage.getItem(TGLAUNCH_KEY);
          if (stored) {
            const storedParams = new URLSearchParams(stored);
            if (storedParams.has("tgWebAppPlatform") || storedParams.has("tgWebAppData")) {
              tgParams = storedParams;
              inTelegram = true;
            }
          }
        } catch {
          // Storage unavailable — regular browser path.
        }
      }
      const colorSchemeMetaEarly = document.querySelector('meta[name="color-scheme"]');

      if (inTelegram) {
        // Telegram forced mode: the client owns the palette and color scheme;
        // the reader-theme preference and system media query are ignored.
        const tgScheme = tgParams.get("tgWebAppColorScheme") === "dark" ? "dark" : "light";
        const root = document.documentElement;
        root.classList.add("telegram");
        root.classList.toggle("dark", tgScheme === "dark");
        if (colorSchemeMetaEarly) {
          colorSchemeMetaEarly.content = tgScheme;
        }
        try {
          const themeParams = JSON.parse(tgParams.get("tgWebAppThemeParams") || "{}");
          for (const [key, value] of Object.entries(themeParams)) {
            if (typeof value === "string") {
              root.style.setProperty(`--tg-theme-${key.replaceAll("_", "-")}`, value);
            }
          }
        } catch {
          // Missing/invalid theme params fall back to the site's light tokens.
        }
      } else {
        let savedTheme = null;
        try {
          const value = localStorage.getItem("reader-theme");
          if (value === "light" || value === "dark") {
            savedTheme = value;
          }
        } catch {
          savedTheme = null;
        }

        const prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
        const theme = savedTheme ?? (prefersDark ? "dark" : "light");
        const colorSchemeMeta = colorSchemeMetaEarly;
        if (colorSchemeMeta) {
          colorSchemeMeta.content = savedTheme ?? "light dark";
        }
        document.documentElement.classList.toggle("dark", theme === "dark");
      }
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">跳转到正文</a>
    <header class="site-header">
      <nav aria-label="主导航">
        <a href="/" aria-label="首页" title="首页" aria-current={isHome ? "page" : undefined}><Icon name="home" /></a>
        <a href="/posts/" aria-label="文章" title="文章" aria-current={isPostsSection ? "page" : undefined}><Icon name="fileText" /></a>
        <button
          class="search-nav-trigger"
          type="button"
          data-search-open
          aria-haspopup="dialog"
          aria-label="搜索"
          title="搜索"
        >
          <Icon name="search" />
        </button>
        <button class="theme-toggle" type="button" data-theme-toggle aria-label="切换主题">
          <Icon name="sun" class="theme-icon theme-icon-sun" />
          <Icon name="moon" class="theme-icon theme-icon-moon" />
        </button>
        <span class="sr-only" role="status" data-theme-status></span>
      </nav>
    </header>
    <dialog
      class="search-dialog"
      closedby="any"
      aria-labelledby="search-dialog-title"
      data-search-dialog
    >
      <div class="search-dialog-header">
        <h2 id="search-dialog-title">站内查找</h2>
        <button class="search-dialog-close" type="button" data-search-close aria-label="关闭" title="关闭">
          <Icon name="close" />
        </button>
      </div>
      <SiteSearch idPrefix="dialog" autoFocus />
    </dialog>
    <main id="main-content">
      <slot />
    </main>
    <footer class="site-footer">
      <p>此处展示的是预览示例内容。</p>
    </footer>
  </body>
</html>

<script>
  import { initTelegram } from "../lib/telegram";

  // Telegram launches need the SDK; inject it after window.load so the
  // external request never delays the load event or the initial paint. The
  // head bootstrap already applied the client palette by then. In-app
  // navigations drop the fragment, so Telegram mode is also inferred from
  // the sessionStorage launch record written by the head bootstrap.
  const hasLaunchKeys = (search: URLSearchParams) =>
    search.has("tgWebAppPlatform") || search.has("tgWebAppData");

  const isTelegramLaunch = (() => {
    const params = new URLSearchParams(window.location.hash.replace(/^#/u, ""));
    if (hasLaunchKeys(params)) {
      return true;
    }
    try {
      const stored = sessionStorage.getItem("tg-launch");
      return stored !== null && hasLaunchKeys(new URLSearchParams(stored));
    } catch {
      return false;
    }
  })();

  if (isTelegramLaunch) {
    window.addEventListener("load", () => {
      initTelegram();
      const sdk = document.createElement("script");
      sdk.src = "https://telegram.org/js/telegram-web-app.js?65";
      sdk.async = true;
      sdk.onload = () => initTelegram();
      document.head.appendChild(sdk);
    });
  }
</script>

<script>
  const toggle = document.querySelector<HTMLButtonElement>("[data-theme-toggle]");
  const status = document.querySelector<HTMLElement>("[data-theme-status]");
  const colorSchemeMeta = document.querySelector<HTMLMetaElement>('meta[name="color-scheme"]');
  const systemDark = window.matchMedia("(prefers-color-scheme: dark)");
  const THEME_KEY = "reader-theme";

  const readThemeOverride = (): "light" | "dark" | null => {
    try {
      const value = localStorage.getItem(THEME_KEY);
      return value === "light" || value === "dark" ? value : null;
    } catch {
      return null;
    }
  };

  const applyTheme = (theme: "light" | "dark", override: "light" | "dark" | null) => {
    document.documentElement.classList.toggle("dark", theme === "dark");
    if (colorSchemeMeta) {
      colorSchemeMeta.content = override ?? "light dark";
    }
    const label = theme === "dark" ? "切换到浅色模式" : "切换到深色模式";
    toggle?.setAttribute("aria-label", label);
    toggle?.setAttribute("title", label);
  };

  const syncTheme = () => {
    const override = readThemeOverride();
    applyTheme(override ?? (systemDark.matches ? "dark" : "light"), override);
  };

  // Inside Telegram the client palette is forced and the toggle is hidden;
  // leave the client-driven classes untouched here.
  if (toggle && !document.documentElement.classList.contains("telegram")) {
    syncTheme();

    toggle.addEventListener("click", () => {
      const rendered = document.documentElement.classList.contains("dark") ? "dark" : "light";
      const target = rendered === "dark" ? "light" : "dark";
      const system = systemDark.matches ? "dark" : "light";

      try {
        if (target === system) {
          localStorage.removeItem(THEME_KEY);
        } else {
          localStorage.setItem(THEME_KEY, target);
        }
        syncTheme();
      } catch {
        applyTheme(target, target);
        if (status) {
          status.textContent = "无法保存主题偏好，刷新后将恢复系统设置";
        }
      }
    });

    systemDark.addEventListener("change", syncTheme);
    window.addEventListener("storage", (event) => {
      if (event.key === THEME_KEY || event.key === null) {
        syncTheme();
      }
    });
  }
</script>

<script>
  const searchOpener = document.querySelector<HTMLButtonElement>("[data-search-open]");
  const searchDialog = document.querySelector<HTMLDialogElement>("[data-search-dialog]");
  const searchCloser = document.querySelector<HTMLButtonElement>("[data-search-close]");

  if (searchOpener && searchDialog) {
    searchOpener.addEventListener("click", () => searchDialog.showModal());
    searchCloser?.addEventListener("click", () => searchDialog.close());

    if (!("closedBy" in HTMLDialogElement.prototype)) {
      const isOutside = (event: PointerEvent) => {
        const rect = searchDialog.getBoundingClientRect();
        return (
          event.clientX < rect.left ||
          event.clientX > rect.right ||
          event.clientY < rect.top ||
          event.clientY > rect.bottom
        );
      };
      let pressedOutside = false;

      searchDialog.addEventListener("pointerdown", (event) => {
        pressedOutside = isOutside(event);
      });
      searchDialog.addEventListener("pointerup", (event) => {
        if (pressedOutside && isOutside(event)) {
          searchDialog.close();
        }
        pressedOutside = false;
      });
    }
  }
</script>
