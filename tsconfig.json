{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "target": "ES2024",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@/modules/*": ["src/modules/*"],
      "@/scripts/*": ["src/scripts/*"],
      "@/components/*": ["src/components/*"],
      "@/layouts/*": ["src/layouts/*"],
      "@/pages/*": ["src/pages/*"],
      "@/styles/*": ["src/styles/*"],
      "@/utils/*": ["src/utils/*"],
      "@/integrations/*": ["src/integrations/*"]
    },
    "types": ["astro/client"]
  },
  "include": ["src/**/*", "tests/**/*", "astro.config.ts", "playwright.config.ts"],
  "exclude": ["node_modules", "dist", ".astro", ".agents"]
}
