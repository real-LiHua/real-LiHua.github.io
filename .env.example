# =============================================================================
# .env.example — real-LiHua.github.io
#
# 复制为 .env 并填入真实值；切勿将含真实密钥的 .env 提交到仓库。
# 存储位置图例：
#   [GH]    GitHub Repository Secrets（Settings → Secrets and variables → Actions）
#   [TG]    tgcloud Secret（tgcloud Dashboard / tgcloud.jsonc）
#   [LOCAL] 仅本地 .env，不入库
# =============================================================================
#
# > [!NOTE] 设施状态（2026-10）
# > 项目已按 `REWRITE_PLAN.md` 从零重写（W0–W10）：`src/`、`.github/workflows/`、`.agents/scripts/`、`.agents/tasks/` 均已在工作区就位。
# > `⏸` 标注对应尚未落地的部分；当前状态见 `PROJECT_STATUS.md`。
#

# -----------------------------------------------------------------------------
# Build / Site
# -----------------------------------------------------------------------------

# 覆盖 astro.config.ts 的 site 配置；部署各平台时由 CI 注入。 [GH] [LOCAL]
SITE_URL="https://real-LiHua.github.io"

# -----------------------------------------------------------------------------
# Deploy — Codeberg Pages
# -----------------------------------------------------------------------------

# SSH 私钥，用于将 dist/client 推送到 Codeberg Pages（git@codeberg.org:lihua/pages）。 [GH]
# 在 Secrets 中粘贴完整多行 PEM/OpenSSH 私钥。轮换周期 90 天。
# 见 docs/adr/0003-deployment-strategy.md 与 docs/SECURITY_WHITEPAPER.md 附录 C。
CODEBERG_PAGES="⏸ 待确认"

# -----------------------------------------------------------------------------
# Deploy — IPFS (Pinata)
# -----------------------------------------------------------------------------

# Pinata API 认证 JWT。IPFS 部署当前禁用（workflow 中 if: false），完成 Pinata 配置与成本评估后再启用。 [GH]
PINATA_JWT_TOKEN="⏸ 待确认"

# -----------------------------------------------------------------------------
# tgcloud Telegram Bot
# -----------------------------------------------------------------------------

# tgcloud API token，用于 CLI 部署 / 数据库迁移 / webhook 管理。 [GH]
TG_API_TOKEN="⏸ 待确认"

# Telegram Bot API token（BotFather 颁发）。仅服务端持有，严禁写入构建产物或前端。 [TG]
TELEGRAM_BOT_TOKEN="⏸ 待确认"

# 受保护内容路由的 JWT 签名密钥（HS256）。泄露后轮换并重新部署即可使旧 JWT 失效。 [TG]
JWT_SECRET="⏸ 待确认"

# -----------------------------------------------------------------------------
# Legacy — Cloudflare（tgcloud 迁移后退役）
# 保留以备回滚参考；新部署不再使用。迁移记录：`ci: migrate from Cloudflare Workers to tgcloud`。
# 见 docs/adr/0003-deployment-strategy.md。
# -----------------------------------------------------------------------------

# Cloudflare 账户 ID。 [GH] — 已退役
CLOUDFLARE_ACCOUNT_ID=""

# Cloudflare API token。 [GH] — 已退役
CLOUDFLARE_API_TOKEN=""

# Cloudflare Pages 预览 URL（历史值）。 [GH] — 已退役
CF_PAGES_URL=""
