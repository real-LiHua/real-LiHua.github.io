{
  "name": "blog",
  "compatibility_date": "2026-09-02",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": "./dist",
  },
  "observability": {
    "enabled": true,
  },
  "send_metrics": false,
  "minify": false,
  "kv_namespaces": [
    {
      "binding": "TG_AUTH_KV",
      "id": "your-kv-namespace-id",
      "preview_id": "your-preview-kv-namespace-id"
    }
  ]
}
